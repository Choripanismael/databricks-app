{
  "datasets": [
    {
      "name": "ultimo_mes",
      "displayName": "Último mes disponible por departamento",
      "config": {
        "version": "1.1",
        "source": "SELECT * FROM cat_finanzas_prod.gold.indicadores_departamento_mensual\nWHERE fecha = (SELECT MAX(fecha) FROM cat_finanzas_prod.gold.indicadores_departamento_mensual)",
        "dimensions": [
          {
            "expr": "departamento"
          },
          {
            "expr": "fecha"
          },
          {
            "name": "credito",
            "expr": "credito_total"
          },
          {
            "name": "deposito",
            "expr": "deposito_total"
          },
          {
            "expr": "ratio_credito_deposito"
          },
          {
            "expr": "dolarizacion_credito"
          },
          {
            "expr": "var_12m_credito"
          },
          {
            "expr": "participacion_credito"
          },
          {
            "expr": "ranking_credito"
          }
        ],
        "measures": [
          {
            "name": "credito_total",
            "expr": "SUM(credito_total)"
          },
          {
            "name": "deposito_total",
            "expr": "SUM(deposito_total)"
          },
          {
            "name": "ratio_cd",
            "expr": "SUM(credito_total) / SUM(deposito_total)"
          },
          {
            "name": "dolarizacion_pond",
            "expr": "SUM(credito_total * dolarizacion_credito) / SUM(credito_total)"
          }
        ]
      }
    },
    {
      "name": "mensual",
      "displayName": "Indicadores mensuales por departamento",
      "config": {
        "version": "1.1",
        "source": "cat_finanzas_prod.gold.indicadores_departamento_mensual",
        "dimensions": [
          {
            "expr": "departamento"
          },
          {
            "expr": "fecha"
          },
          {
            "expr": "anio"
          }
        ],
        "measures": [
          {
            "name": "credito_total",
            "expr": "SUM(credito_total)"
          },
          {
            "name": "deposito_total",
            "expr": "SUM(deposito_total)"
          },
          {
            "name": "dolarizacion_credito",
            "expr": "SUM(credito_total * dolarizacion_credito) / SUM(credito_total)"
          }
        ]
      }
    },
    {
      "name": "anual",
      "displayName": "Resumen anual por departamento",
      "config": {
        "source": "cat_finanzas_prod.gold.resumen_anual_departamento",
        "measures": [
          {
            "name": "crecimiento_credito",
            "expr": "AVG(crecimiento_credito)"
          }
        ],
        "filter": "crecimiento_credito IS NOT NULL",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "departamento"
          },
          {
            "expr": "anio"
          },
          {
            "name": "signo",
            "expr": "CASE WHEN crecimiento_credito >= 0 THEN 'Positivo' ELSE 'Negativo' END"
          }
        ]
      }
    },
    {
      "name": "intermediacion",
      "displayName": "Mapa de intermediación, último mes",
      "queryLines": [
        "SELECT\n",
        "  departamento,\n",
        "  credito_total,\n",
        "  deposito_total,\n",
        "  ratio_credito_deposito,\n",
        "  dolarizacion_credito,\n",
        "  CASE\n",
        "    WHEN ratio_credito_deposito > 1.2 THEN 'Presta mucho más de lo que capta'\n",
        "    WHEN ratio_credito_deposito >= 1 THEN 'Presta más de lo que capta'\n",
        "    ELSE 'Capta más de lo que presta'\n",
        "  END AS segmento\n",
        "FROM\n",
        "  cat_finanzas_prod.gold.indicadores_departamento_mensual\n",
        "WHERE\n",
        "  fecha\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(fecha)\n",
        "      FROM\n",
        "        cat_finanzas_prod.gold.indicadores_departamento_mensual\n",
        "    )"
      ]
    }
  ],
